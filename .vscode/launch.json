    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Zsh Script build.sh",
            "type": "node",
            "request": "launch",
            "program": "build.sh", // Path to your Zsh script
            "console": "integratedTerminal",
            "runtimeExecutable": "zsh", // Set Zsh as the runtime to execute the script
            "args": []
        },
        {
            "type": "zshdb",
            "request": "launch",
            "name": "Zsh-Debug (hardcoded script name)",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/path/to/script.sh",
            "args": []
        },
    ]
}
